{
  "modelVersion": "6.1.1",
  "description": "Pi Desktop Ark（HarmonyOS）—— 进程内 Node + pi-web 服务 + ArkWeb 渲染",
  "dependencies": {
    // 消费方接线（ohpm 中心仓，常规依赖）：
    //   主包 `@fellow99/node-bridge` 只带 ArkTS API + NAPI 引导件（libnode_bridge.so），**不带** libnode.so；
    //   运行时 `@fellow99/node-runtime`（版本 = Node 版本）带 libs/arm64-v8a/libnode.so + libc++_shared.so，
    //   由 hvigor 随 HAP 合并。两包来源：https://ohpm.openharmony.cn/（库仓库：github.com/fellow99/ohos-node-bridge）。
    //   ⚠️ 两种获取方式择一：要么 ohpm 包，要么手工投放 .so —— 不要同时放同名 .so。
    //   历史：`file:./libs/@fellow99/node-bridge.har` 本地旁路已退役（库 2026-10-22 上架中心仓）。
    "@fellow99/node-bridge": "0.1.0",
    "@fellow99/node-runtime": "24.2.0"
  },
  "devDependencies": {}
}
