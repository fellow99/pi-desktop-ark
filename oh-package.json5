{
  "modelVersion": "6.1.1",
  "description": "Pi Desktop V2（HarmonyOS）—— 进程内 Node + pi-web 服务 + ArkWeb 渲染",
  "dependencies": {
    // 消费方接线（工程规划 §7.5 / 附录 G.8）：
    //   HAR 只带 ArkTS + NAPI 引导件，**不带** libnode.so（121 MB）；
    //   运行时由 scripts/provision-runtime.sh 调 ohos-node-bridge/tools/provision.mjs 投放。
    //
    // 依赖的是**构建好的 HAR**（不是源目录）：本工程开着 useNormalizedOHMUrl，
    // 该模式下跨工程以相对路径导入源码会被 hvigor 拒（00309001）。
    // 先用 scripts/build-bridge-har.sh 生成它；发布到 ohpm 后换成版本号（如 "0.1.0"）。
    "@fellow99/node-bridge": "file:./libs/@fellow99/node-bridge.har"
  },
  "devDependencies": {}
}
