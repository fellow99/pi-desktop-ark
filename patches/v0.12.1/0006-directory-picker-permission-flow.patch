diff --git a/app/api/host/perm/route.ts b/app/api/host/perm/route.ts
new file mode 100644
index 0000000..81dbe05
--- /dev/null
+++ b/app/api/host/perm/route.ts
@@ -0,0 +1,104 @@
+import { NextResponse } from "next/server";
+import { join } from "path";
+import { hasJsonContentType, isApiRequestAllowed } from "@/lib/request-security";
+
+/**
+ * POST /api/host/perm — 让**页面**触发一次 OS 授权窗（FR-203-017）。
+ *
+ * 为什么需要这条路由：授权窗只能由 ArkTS 侧 `abilityAccessCtrl.requestPermissionsFromUser`
+ * 弹出，而"用户点了『请求权限』按钮"这件事发生在浏览器里。两侧的唯一通道是库的**文件信箱**
+ * （`host.js` 的 `invoke`，E18），它由 Node 起（与 Next 同一个进程），因此这条路由只做
+ * 「转发 + 只允许用户目录权限」两件事，不引入任何新的传输实现。
+ *
+ * 允许清单是**白名单**：只放两个 normal 级的用户目录权限。任何人都不能借这条路由去请求
+ * 别的（例如 system_basic）权限 —— 那会变成"随便给任意权限弹窗"的后门。
+ */
+export const dynamic = "force-dynamic";
+
+/** 产物标记：`assemble-payload` 用它判断载荷里的 .next 是否已包含本补丁。 */
+const PERM_FLOW_MARKER = "pi-hos-perm-manual";
+
+const ALLOWED_PERMISSIONS = new Set([
+  "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",
+  "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
+]);
+
+type PermRequestResult = {
+  requested?: number;
+  granted?: number;
+  denied?: number;
+  results?: Array<{ permission?: string; authResult?: number; granted?: boolean }>;
+};
+
+export async function POST(request: Request) {
+  if (!isApiRequestAllowed(request) || !hasJsonContentType(request)) {
+    return NextResponse.json({ error: "Permission request is not allowed" }, { status: 403 });
+  }
+
+  let permission = "";
+  try {
+    const body = (await request.json()) as { permission?: unknown };
+    permission = typeof body.permission === "string" ? body.permission : "";
+  } catch {
+    return NextResponse.json({ error: "Invalid JSON body" }, { status: 400 });
+  }
+  if (!ALLOWED_PERMISSIONS.has(permission)) {
+    return NextResponse.json({ error: "Unsupported permission", permission }, { status: 400 });
+  }
+
+  // 宿主垫片：与 pi-web 同目录（`<payload>/pi-web/host.js`）。用 eval("require") 让打包器
+  // 不要静态分析这个路径（它是运行期才存在的文件）。
+  type HostShim = {
+    invoke: (name: string, payload?: unknown, opts?: { timeoutMs?: number }) => Promise<unknown>;
+    useFileMailbox?: (dir: string) => { ok?: boolean; error?: string; detail?: string };
+  };
+  let host: HostShim;
+  try {
+    // eslint-disable-next-line no-eval
+    const nodeRequire = eval("require") as NodeRequire;
+    host = nodeRequire(join(process.cwd(), "host.js")) as HostShim;
+    /*
+     * ⚠️ 必须**就地接线信箱**：pi-web-launch 装的是 `<resfile>/pi-web/host.js` 那一份，
+     * 而这条路由 require 的是 `<payload>/pi-web/host.js` —— 两份是**不同的模块实例**，
+     * 上面那份的 mailbox 状态不会共享过来（实测症状：`transport-unavailable name=perm.request`）。
+     * `useFileMailbox` 对已存在目录是幂等的，这里按环境变量再接线一次即可。
+     */
+    const mailboxDir = process.env.PI_HOST_MAILBOX ?? "";
+    if (mailboxDir.length > 0 && typeof host.useFileMailbox === "function") {
+      const wired = host.useFileMailbox(mailboxDir);
+      if (wired?.ok !== true) {
+        return NextResponse.json(
+          { error: "mailbox-unavailable", detail: wired?.detail ?? wired?.error ?? "unknown" },
+          { status: 503 },
+        );
+      }
+    }
+  } catch (error) {
+    return NextResponse.json(
+      { error: "host bridge unavailable", detail: String((error as Error)?.message ?? error) },
+      { status: 503 },
+    );
+  }
+
+  try {
+    // 用户在系统弹窗上点按的时间不可控 ⇒ 超时给足（库侧默认远小于此）。
+    const result = (await host.invoke(
+      "perm.request",
+      { permissions: [permission] },
+      { timeoutMs: 120000 },
+    )) as PermRequestResult;
+    const granted = typeof result?.granted === "number" ? result.granted : 0;
+    return NextResponse.json({ ok: true, marker: PERM_FLOW_MARKER, permission, granted: granted > 0, result });
+  } catch (error) {
+    const err = error as { error?: string; detail?: string; message?: string };
+    return NextResponse.json(
+      {
+        ok: false,
+        permission,
+        error: err?.error ?? "perm-request-failed",
+        detail: err?.detail ?? err?.message ?? String(error),
+      },
+      { status: 502 },
+    );
+  }
+}
