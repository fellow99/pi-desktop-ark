+/**
+ * 浏览失败。带 `permission`/`canRequest` 的 403 表示"目录本身存在、只是还没授权"，
+ * 调用方据此显示「请求权限 / 刷新」两个按钮 —— 与"目录真的不存在"（404/ENOENT）必须分开。
+ */
+class BrowseError extends Error {
+  readonly code: string | null;
+  readonly permission: string | null;
+  readonly canRequest: boolean;
+
+  constructor(message: string, code: string | null, permission: string | null, canRequest: boolean) {
+    super(message);
+    this.name = "BrowseError";
+    this.code = code;
+    this.permission = permission;
+    this.canRequest = canRequest;
+  }
+}
+
+/** 触发一次 OS 授权窗（经 `/api/host/perm` → 文件信箱 → ArkTS `perm.request`）。 */
+async function requestHostPermission(permission: string): Promise<boolean> {
+  try {
+    const response = await fetch("/api/host/perm", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ permission }),
+    });
+    if (!response.ok) return false;
+    const data = await response.json() as { ok?: boolean; granted?: boolean };
+    return data.ok === true && data.granted === true;
+  } catch {
+    return false;
+  }
+}
