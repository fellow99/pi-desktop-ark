diff --git a/lib/hos-sandbox-path.ts b/lib/hos-sandbox-path.ts
new file mode 100644
index 0000000..ed2bf4b
--- /dev/null
+++ b/lib/hos-sandbox-path.ts
@@ -0,0 +1,65 @@
+/**
+ * pi-desktop（宿主应用）沙箱路径的**两种写法**，指向同一个目录：
+ *
+ *   ① el2 别名（应用自己的 API 只认这个，也是 `context.filesDir` 的形态）
+ *        `/data/storage/el2/base/haps/<module>/files[/…]`
+ *   ② `hdc shell` 视角（开发者在设备上 `ls` 到的是这个）
+ *        `/data/app/el2/<uid>/base/<bundle>/haps/<module>/files[/…]`
+ *
+ * ②->① 的映射**以 HOME 为锚**：HOME 是宿主注入的应用沙箱根（ArkTS 侧
+ * `context.filesDir`），它本身就是 ① 的形态。因此本模块不硬编码任何 bundle/uid：
+ * 只要 HOME 形如 ①，就把 ② 的 `<前缀>/haps/<module>/files` 换成 HOME。
+ *
+ * 三条性质（本补丁的验收口径）：
+ *   · **幂等**：① 形态不再匹配 ②，重复调用逐字节不变；
+ *   · **可逆**：只重写请求里的路径，不写盘、不缓存 —— 响应回显的是 ① 形态，
+ *     与 ② 是同一个真实目录，调用方可原样拿回自己给的 ② 继续用；
+ *   · **不猜测**：HOME 不是 ① 的形态（非鸿蒙 / 沙箱被重定向）时**原样返回**。
+ *
+ * 为什么需要它：真机上 ② 形态以前一律 400 `Directory does not exist`（路由把路径
+ * 直接交给 `statSync`/`existsSync`，而 ② 只是 hdc 的视图）。把「用户手打的合法写法」
+ * 报成「目录不存在」会让人怀疑工作区没建，排查方向从一开始就是错的。
+ */
+
+import { homedir } from "os";
+
+/** ① el2 别名形态（HOME 必须正好是这个形态，才谈得上映射）。 */
+const EL2_ALIAS_HOME = /^\/data\/storage\/el2\/base\/haps\/([^/]+)\/files\/?$/;
+
+/** 编译产物里的稳定标记（`assemble-payload.mjs` 用它断言补丁真的进了载荷）。 */
+export const HOS_PATH_ALIAS_MARKER = "pi-hos-sandbox-alias";
+
+function escapeRegExp(text: string): string {
+  return text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+}
+
+/**
+ * 把 `hdc shell` 视角的沙箱路径改写为 el2 别名。
+ *
+ * @param input 调用方给的路径（可能是 ①、②、`~/…` 或普通路径）
+ * @param home 应用沙箱根（默认 `homedir()`；单测可显式传入）
+ * @returns 改写后的路径；不需要/不能改写时返回**原值**（同一性由调用方可判断）
+ */
+export function normalizeHosSandboxPath(input: string, home: string = homedir()): string {
+  if (!input) return input;
+  const aliasHome = home.replace(/\/+$/, "");
+  const match = EL2_ALIAS_HOME.exec(aliasHome);
+  if (!match) return input;
+  const hdcPrefix = new RegExp(
+    `^/data/app/el2/\\d+/base/[^/]+/haps/${escapeRegExp(match[1])}/files(?=/|$)`,
+  );
+  const rest = input.replace(hdcPrefix, "");
+  if (rest === input) return input;
+  return `${aliasHome}${rest}`;
+}
+
+/**
+ * 给「路径仍然不存在」的 400 加一句**可诊断**的提示：期望形态、收到的形态、
+ * 以及是否做过改写。纯信息，不参与判定。
+ */
+export function describePathForms(received: string, normalized: string): string {
+  const forms = [`received=${received}`, `expected=${normalized}`];
+  if (normalized !== received) forms.push("normalized=el2-alias");
+  forms.push(HOS_PATH_ALIAS_MARKER);
+  return forms.join(" ");
+}
