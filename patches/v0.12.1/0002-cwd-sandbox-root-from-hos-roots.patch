+ * `…/el2/base/files/workspace`（少了 `haps/<module>`，真机 404）拼出来的那条路。
+ * 因此起点只认宿主声明的 `sandbox` 根，且**只在它真实存在时**采用 —— 声明的根
+ * 不存在（宿主启动失败）就退回 `homedir()`，不让选择器停在一个不存在的目录上。
+ */
 export function getBrowseStartDirectory(directory?: string): string {
-  return directory || homedir();
+  if (directory) return directory;
+  const sandbox = findWorkspaceRoot(WORKSPACE_ROOT_ID_SANDBOX);
+  if (sandbox && existsSync(sandbox.path)) return sandbox.path;
+  return homedir();
 }
 
